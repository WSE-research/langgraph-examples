# The committed twin of `.env`: the same variable names, none of the secret
# values. A fresh clone is made to run by copying this file and filling in the
# three lines that are placeholders on purpose.
#
#   cp .env.example .env            # macOS, Linux
#   copy .env.example .env          # Windows, cmd.exe
#   Copy-Item .env.example .env     # Windows, PowerShell
#
# Then open `.env` and fill in the three lines of the LLM endpoint --
# OPENAI_API_BASE, OPENAI_API_KEY and MODEL_NAME. They are provided on-site,
# independently of this repository. Everything else below is already correct.
#
# `.env` is in `.gitignore` and has to stay there: it is the only file in this
# repository that holds a credential. This file is the reason that rule costs
# nothing -- nobody has to guess what a working `.env` contains.

# --- the Pizza API -----------------------------------------------------------
# No PIZZA_API_BASE here: the version of the Pizza API (v3 in this iteration)
# is in the adapter, pizzabot/pizza_api.py, which every iteration ships -- not
# in .env. Delete any PIZZA_API_BASE line an earlier iteration left in your
# .env. Only if the service does not answer (check with `python check_setup.py`):
# start the local stub in a second terminal -- `python pizza_api_stub.py` -- and
# use this line:
# PIZZA_API_BASE=http://127.0.0.1:8000
PIZZA_API_TIMEOUT=10

# --- the LLM endpoint -- needed from Iteration 2 on ----------------------------
# The endpoint, its access code and the model name are provided on-site,
# independently of this repository. There is no default for any of the three:
# nothing is sent to a service, or billed to a model, that nobody chose. The
# code treats a value that still starts with "<" as missing -- an unfilled
# template switches the LLM configuration off and says which line is missing,
# instead of producing a confusing HTTP 401. The endpoint speaks the OpenAI
# protocol; the variable names say OPENAI_ because that is what the client
# library reads -- nothing here talks to OpenAI.
OPENAI_API_BASE=<provided on-site>
# Paste the access code raw -- no quotes, no spaces, no angle brackets.
OPENAI_API_KEY=<provided on-site>
# Pinned on purpose: a different model is a different implementation and must
# be re-measured. `python check_llm.py` lists the models the endpoint offers.
MODEL_NAME=<provided on-site>
LLM_TIMEOUT=20
LLM_RETRIES=2

# --- which implementation sits behind the two recognizers --------------------
# static = the Iteration 1 rules, llm = the Iteration 2 service calls.
# The command line wins: `python run_dialog.py --config llm`.
BOT_CONFIG=static

# --- output ------------------------------------------------------------------
# INFO shows the node trace (default), WARNING hides it -- use WARNING on a
# beamer. NO_COLOR=1 switches the colours off.
LOG_LEVEL=INFO
