# Copy this file to `.env` and adjust. `.env` is in .gitignore -- never commit a key.
#
#   cp .env.example .env

# --- the Pizza API -----------------------------------------------------------
# The university API. Open the URL in a browser: it answers with its own
# interactive documentation (Swagger UI), and /openapi.json has the schema.
PIZZA_API_BASE=https://wse-research.org/pizza-api
# If it does not answer (check with `python check_setup.py`), start the local
# stub in a second terminal -- `python pizza_api_stub.py`, which serves the same
# endpoint list at http://127.0.0.1:8000 -- and use this line:
# PIZZA_API_BASE=http://127.0.0.1:8000

# --- the LLM endpoint (ILaaS), only needed for Task 8 ------------------------
# Both ILaaS services speak the OpenAI protocol, so the OpenAI client works.
OPENAI_API_BASE=https://llm.ilaas.fr/v1
OPENAI_API_KEY=<the key you were given in the exercise session>
MODEL_NAME=mistral-small-4-119b

# --- output ------------------------------------------------------------------
# INFO shows the node trace (default), WARNING hides it.
LOG_LEVEL=INFO
