# =====================================================================
# the toppings -- the evidence behind the flags above
# =====================================================================

pz:Tomato a pz:Topping ; pz:name "tomato" ;
    pz:alias "tomato sauce" .

pz:Mozzarella a pz:Topping ; pz:name "mozzarella" ;
    pz:containsMilk true .

pz:BuffaloMozzarella a pz:Topping ; pz:name "mozzarella di bufala" ;
    pz:alias "buffalo mozzarella" ;
    pz:containsMilk true .

pz:Gorgonzola a pz:Topping ; pz:name "gorgonzola" ;
    pz:containsMilk true .

pz:Parmesan a pz:Topping ; pz:name "parmesan" ;
    pz:alias "parmigiano" ;
    pz:containsMilk true .

pz:Fontina a pz:Topping ; pz:name "fontina" ;
    pz:containsMilk true .

pz:Ricotta a pz:Topping ; pz:name "ricotta" ;
    pz:containsMilk true .

pz:Cream a pz:Topping ; pz:name "cream" ;
    pz:containsMilk true .

pz:Basil a pz:Topping ; pz:name "basil" .

pz:Oregano a pz:Topping ; pz:name "oregano" .

pz:Garlic a pz:Topping ; pz:name "garlic" .

pz:OliveOil a pz:Topping ; pz:name "olive oil" .

pz:Olive a pz:Topping ; pz:name "olives" ;
    pz:alias "olive" .

pz:Mushroom a pz:Topping ; pz:name "mushrooms" ;
    pz:alias "mushroom", "funghi" .

pz:Truffle a pz:Topping ; pz:name "truffle" ;
    pz:alias "tartufo" .

pz:Rocket a pz:Topping ; pz:name "rocket" ;
    pz:alias "arugula", "rucola" .

pz:Courgette a pz:Topping ; pz:name "courgette" ;
    pz:alias "zucchini" .

pz:Aubergine a pz:Topping ; pz:name "aubergine" ;
    pz:alias "eggplant" .

pz:BellPepper a pz:Topping ; pz:name "bell pepper" ;
    pz:alias "peppers", "capsicum" .

pz:Onion a pz:Topping ; pz:name "onion" ;
    pz:alias "onions" .

pz:RedOnion a pz:Topping ; pz:name "red onion" .

pz:Pineapple a pz:Topping ; pz:name "pineapple" .

pz:Caper a pz:Topping ; pz:name "capers" ;
    pz:alias "caper" .

pz:Chilli a pz:Topping ; pz:name "chilli" ;
    pz:alias "chili", "peperoncino" .

pz:Parsley a pz:Topping ; pz:name "parsley" .

pz:Artichoke a pz:Topping ; pz:name "artichokes" ;
    pz:alias "artichoke", "carciofi" .

pz:Ham a pz:Topping ; pz:name "ham" ;
    pz:alias "cooked ham", "prosciutto cotto" ;
    pz:containsMeat true .

pz:Salami a pz:Topping ; pz:name "salami" ;
    pz:containsMeat true .

pz:PepperoniSausage a pz:Topping ; pz:name "pepperoni" ;
    pz:alias "salami piccante", "spicy salami" ;
    pz:containsMeat true .

pz:Sausage a pz:Topping ; pz:name "sausage" ;
    pz:alias "salsiccia" ;
    pz:containsMeat true .

pz:Egg a pz:Topping ; pz:name "egg" ;
    pz:containsEgg true .

pz:Anchovy a pz:Topping ; pz:name "anchovies" ;
    pz:alias "anchovy", "acciughe" ;
    pz:containsFish true .

pz:Tuna a pz:Topping ; pz:name "tuna" ;
    pz:alias "tonno" ;
    pz:containsFish true .

pz:Seafood a pz:Topping ; pz:name "seafood" ;
    pz:alias "mussels, squid and prawns" ;
    pz:containsFish true .
