# The committed twin of `.env`: the same variable names, none of the secret
# values. A fresh clone is made to run by copying this file and filling in the
# one line that is empty on purpose.
#
#   cp .env.example .env            # macOS, Linux
#   copy .env.example .env          # Windows, cmd.exe
#   Copy-Item .env.example .env     # Windows, PowerShell
#
# Then open `.env` and paste your ILaaS key into OPENAI_API_KEY. Everything
# else below is already correct -- you do not have to change a single other
# line to complete this iteration.
#
# `.env` is in `.gitignore` and has to stay there: it is the only file in this
# repository that holds a credential. This file is the reason that rule costs
# nothing -- nobody has to guess what a working `.env` contains.

# --- the Pizza API -----------------------------------------------------------
PIZZA_API_BASE=https://wse-research.org/pizza-api
# If it does not answer (check with `python check_setup.py`), start the local
# stub in a second terminal -- `python pizza_api_stub.py` -- and use this line:
# PIZZA_API_BASE=http://127.0.0.1:8000
PIZZA_API_TIMEOUT=10

# --- the LLM service (ILaaS inference) -- needed from Iteration 2 on ---------
# ILaaS (https://www.ilaas.fr) is the model service of Universite Jean Monnet.
# It speaks the OpenAI protocol, so the OpenAI client library works against it
# unchanged. The variable names say OPENAI_ because that is what the client
# reads -- nothing here talks to OpenAI.
OPENAI_API_BASE=https://llm.ilaas.fr/v1
# The one value you have to supply: the key you were given in Iteration 1,
# Task 8. Paste it raw -- no quotes, no spaces, no angle brackets. The code
# treats a value that still starts with "<" as "no key", so an unfilled
# template fails loudly instead of producing a confusing HTTP 401.
OPENAI_API_KEY=<the key you were given in the exercise session>
MODEL_NAME=mistral-small-4-119b
# Pinned on purpose: a different model is a different implementation and must
# be re-measured. Verified alternatives: qwen-3.6-35b-instruct (clean JSON,
# fastest), gemma-4-31b, llama-3.1-8b.
LLM_TIMEOUT=20
LLM_RETRIES=2

# The same two services under their own names. `llm_service.py` reads these as
# a fallback, so a `.env` written for `ilaas-connector/` also works here:
#   ILAAS_INFERENCE_BASE_URL, ILAAS_API_KEY, ILAAS_CHAT_MODEL

# --- the ILaaS RAG service -- not used in this iteration ---------------------
# A second service with a second key: collections, retrieval, embeddings and
# reranking. Iteration 5 (the retrieval branch) is the first that needs it;
# it is named here so that today's `.env` is already the right shape then.
# ILAAS_RAG_BASE_URL=https://rag-api.ilaas.fr/v1
# ILAAS_RAG_API_KEY=<the RAG token -- a second, different key>
# ILAAS_RAG_CHAT_MODEL=gpt-oss-120b
# ILAAS_EMBEDDING_MODEL=bge-m3
# ILAAS_RERANK_MODEL=bge-reranker-v2-m3

# --- which implementation sits behind the two recognizers --------------------
# static = the Iteration 1 rules, llm = the Iteration 2 service calls.
# The command line wins: `python run_dialog.py --config llm`.
BOT_CONFIG=static

# --- output ------------------------------------------------------------------
# INFO shows the node trace (default), WARNING hides it -- use WARNING on a
# beamer. NO_COLOR=1 switches the colours off.
LOG_LEVEL=INFO
